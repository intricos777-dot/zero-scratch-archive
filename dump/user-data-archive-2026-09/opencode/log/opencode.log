timestamp=2026-09-26T19:36:16.710Z level=INFO run=01b4c3ae message=evaluated permission=bash pattern="python3 - <<'PY'\nimport configparser, os\nc=configparser.ConfigParser(strict=False, interpolation=None)\nc.read('shield-kitty-fail2ban.local')\nok=True\nfor s in c.sections():\n    f=c[s].get('filter'); b=c[s].get('banaction')\n    fp=f\"/etc/fail2ban/filter.d/{f}.conf\"\n    exists=os.path.exists(fp)\n    ok &= exists\n    print(f\"  {s:<12} filter={f:<12} {'[✓]' if exists else '[✗] MISSING'}\")\nact=c['DEFAULT'].get('banaction')\nap=f\"/etc/fail2ban/action.d/{act}.conf\"\nprint(f\"  {'DEFAULT':<12} action={act:<12} {'[✓]' if os.path.exists(ap) else '[✗] MISSING'}\")\nprint()\nprint(\"  RESULT:\", \"all dependencies satisfied\" if ok and os.path.exists(ap) else \"MISSING DEPS\")\nPY" action.permission=* action.action=allow action.pattern=*
