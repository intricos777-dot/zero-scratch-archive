timestamp=2026-09-26T19:40:42.865Z level=INFO run=01b4c3ae message=evaluated permission=bash pattern="python3 - <<'PY'\np='shield-kitty-fail2ban.local'\ns=open(p).read()\n\n# 1. backend must be systemd for journalmatch to work at all\ns=s.replace(\"\"\"backend = auto\nusedns = no\"\"\",\n\"\"\"# backend=auto tries only pyinotify/polling — it does NOT include systemd,\n# so a journalctl logpath was silently ignored. This system is journald-only:\n# no syslog-ng, no rsyslog, no /var/log/auth.log. systemd backend is required.\nbackend = systemd\nusedns = no\"\"\")\n\n# 2. per-jail: journalmatch, no logpath\ns=s.replace(\"\"\"[sddm]\nenabled  = true\nport     = sddm\nfilter   = pam-generic\nlogpath  = /var/log/auth.log\n          journalctl -f -u sddm.service -u sddm-greeter.service\nmaxretry = 5\nbantime  = -1\"\"\",\n\"\"\"[sddm]\nenabled  = true\nport     = sddm\nfilter   = pam-generic\n# No logpath: with backend=systemd, logpath is not valid. Select via\n# journalmatch instead. _TRANSPORT=auth is where PAM denials land.\njournalmatch = _SYSTEMD_UNIT=sddm.service + _TRANSPORT=auth\n               _SYSTEMD_UNIT=sddm-greeter.service + _TRANSPORT=auth\nmaxretry = 5\nbantime  = -1\"\"\")\n\ns=s.replace(\"\"\"[sudo]\nenabled  = true\nport     = sudo\nfilter   = pam-generic\nlogpath  = /var/log/auth.log\n          journalctl -f -u sudo.service\nmaxretry = 4\nbantime  = -1\"\"\",\n\"\"\"[sudo]\nenabled  = true\nport     = sudo\nfilter   = pam-generic\njournalmatch = _COMM=sudo + _TRANSPORT=auth\nmaxretry = 4\nbantime  = -1\"\"\")\n\ns=s.replace(\"\"\"[sshd]\nenabled  = true\nport     = ssh\nfilter   = sshd\nlogpath  = /var/log/auth.log\n          journalctl -f -u sshd.service\nmaxretry = 4\nbantime  = -1\"\"\",\n\"\"\"[sshd]\nenabled  = true\nport     = ssh\nfilter   = sshd\njournalmatch = _SYSTEMD_UNIT=sshd.service + _TRANSPORT=auth\nmaxretry = 4\nbantime  = -1\"\"\")\n\ns=s.replace(\"\"\"[recidive]\n# ⚠ BOOTSTRAP\"\"\",\"\"\"[recidive]\n# ⚠ BOOTSTRAP\"\"\")\ns=s.replace(\"\"\"logpath  = /var/log/fail2ban.log\nmaxretry = 3\"\"\",\"\"\"# recidive must read fail2ban's own FILE log — the systemd journal does not\n# contain it. Enable this only after fail2ban has run once and created\n# /var/log/fail2ban.log. It also needs a non-systemd backend override.\nbackend = polling\nlogpath  = /var/log/fail2ban.log\nmaxretry = 3\"\"\")\nopen(p,'w').write(s)\nprint(\"  [✓] rewritten for journald\")\nPY" action.permission=* action.action=allow action.pattern=*
