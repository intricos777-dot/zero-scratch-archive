timestamp=2026-09-26T21:31:08.860Z level=INFO run=501861cf message=evaluated permission=bash pattern="python3 - <<'PY'\ndef can(mode, who, want):\n    m = int(mode, 8)\n    shift = 6 if who=='owner' else 3 if who=='group' else 0\n    bits = (m >> shift) & 7\n    return {4:'r',2:'w',1:'x',6:'rw',7:'rwx',5:'rx',3:'wx',0:''}[bits]\ncases = [\n (\"/var/lib/arpwatch\",       \"0755\", \"livings(others)\", \"livings traverses + reads dir\"),\n (\"/var/lib/arpwatch/arp.dat\",\"0644\", \"livings(others)\", \"livings reads addresses\"),\n (\"/var/lib/arpwatch/spoof-state\",\"0644\",\"livings(owner)\",\"livings rewrites dedup state\"),\n (\"/var/log/arpwatch-spoof.log\",\"0640\",\"livings(owner)\",\"livings appends scan log\"),\n]\nfor p,m,w,why in cases:\n    print(f\"  {p:38} {m} {w:16} -> {'r' if can(m,w.split('(')[1][:-1],'r') in can(m,w.split('(')[1][:-1],'r') else ''}{can(m,'others' if 'others' in w else 'owner','r')}{can(m,'others' if 'others' in w else 'owner','w')}  {why}\")\nPY" action.permission=* action.action=allow action.pattern=*
