timestamp=2026-09-26T21:33:56.797Z level=INFO run=501861cf message=evaluated permission=bash pattern="python3 - <<'PY'\nimport pathlib\np = pathlib.Path(\"install-arpwatch-spoof.sh\")\ns = p.read_text()\ns = s.replace(\n 'ARPWATCH_ARGS=\"-F -i $IFACE -f $DB -s -N -z\"',\n 'ARPWATCH_ARGS=\"-F -i $IFACE -f $DB -D /var/lib/arpwatch -P $PIDFILE -s -N -z\"')\ns = s.replace(\n 'DB=/var/lib/arpwatch/arp.dat',\n 'DB=/var/lib/arpwatch/arp.dat\\nPIDFILE=/run/arpwatch-spoof.pid')\n# probe must use a throwaway pidfile so it cannot clobber the live one\ns = s.replace(\n 'if probe_out=\"$(timeout 3 arpwatch -F -i \"$IFACE\" -f \"$ARPWATCH_PROBE_DB\" -s -N -z 2>&1)\"; then',\n 'if probe_out=\"$(timeout 3 arpwatch -F -i \"$IFACE\" -f \"$ARPWATCH_PROBE_DB\" -D /var/lib/arpwatch -P \"$ARPWATCH_PROBE_PID\" -s -N -z 2>&1)\"; then')\ns = s.replace(\n 'ARPWATCH_PROBE_DB=\"$(mktemp -u)/probe.dat\"\\nmkdir -p \"$(dirname \"$ARPWATCH_PROBE_DB\")\"',\n 'ARPWATCH_PROBE_DB=\"$(mktemp -u)/probe.dat\"\\nARPWATCH_PROBE_PID=\"$(mktemp -u)/probe.pid\"\\nmkdir -p \"$(dirname \"$ARPWATCH_PROBE_DB\")\"')\n# state file is written by a now-privileged scan unit; root can write it regardless,\n# but keep it user-owned so a future unprivileged scan also works\ns = s.replace(\n 'run sudo install -m 0644 -o livings -g livings /dev/null /var/lib/arpwatch/spoof-state',\n 'run sudo install -m 0644 -o livings -g livings /dev/null /var/lib/arpwatch/spoof-state')\np.write_text(s)\nprint(\"patched\")\nPY" action.permission=* action.action=allow action.pattern=*
