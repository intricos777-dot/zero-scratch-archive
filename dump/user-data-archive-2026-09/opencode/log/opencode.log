timestamp=2026-09-26T20:48:11.417Z level=INFO run=01b4c3ae message=evaluated permission=bash pattern="rsync -a --exclude='.git' --exclude='venv' --exclude='__pycache__' --exclude='*.bak' --exclude='*.pyc' \\\n      ~/Projects/zen-hardening/ config/zen-hardening/" action.permission=* action.action=allow action.pattern=*
timestamp=2026-09-26T20:48:11.417Z level=INFO run=01b4c3ae message=evaluated permission=bash pattern="git add -A" action.permission=* action.action=allow action.pattern=*
timestamp=2026-09-26T20:48:11.417Z level=INFO run=01b4c3ae message=evaluated permission=bash pattern="git -c user.name=opencode -c user.email=opencode@localhost commit -q -m \"Verify MAC in bootstrap; discover iface instead of hardcoding wlo0\n\nbootstrap.sh checked the hostname but not the MAC, so it reported\n'BASELINE OK, 0 checks failed' while the machine was still\nbroadcasting its hardware address. Identity was incomplete and the\nscript said it was fine.\n\nThe check now fails closed: it requires the randomization setting to be\n'always' AND the live address to be locally administered (first octet\nbit 1 set). Checking the setting alone is insufficient, because NM only\napplies the new address at connection activation, so 'always' can read\ncorrectly while the interface still carries the burned-in MAC until a\nreconnect happens.\n\nset-home-trusted-zone.sh hardcoded wlo0. Interface names are not stable\nacross machines or reboots, and a stale name lets the firewall bind\nnothing while still reporting success. It now discovers the interface\nfrom the connection and fails loudly if it cannot, rather than binding\na name that may not exist.\n\nCo-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>\" 2>&1" action.permission=* action.action=allow action.pattern=*
