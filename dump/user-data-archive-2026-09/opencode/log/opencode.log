timestamp=2026-09-26T19:36:16.710Z level=INFO run=01b4c3ae message=evaluated permission=bash pattern="python3 - <<'PY'\np='shield-kitty-fail2ban.local'\ns=open(p).read()\ns=s.replace(\"\"\"# ── SDDM / graphical login ────────────────────────────────────────────────\n# The real attack surface on a laptop. Anyone who walks up or reaches this\n# machine over the network hits this.\n[sddm]\nenabled  = true\nport     = sddm\nfilter   = sddm\nlogpath  = /var/log/auth.log\n          journalctl -f -u sddm.service -u sddm-greeter.service\nmaxretry = 5\nbantime  = -1\n\n# ── sudo ──────────────────────────────────────────────────────────────────\n# Privilege-escalation attempts. Permanently bans any host repeatedly\n# failing sudo.\n[sudo]\nenabled  = true\nport     = sudo\nfilter   = sudo\nlogpath  = /var/log/auth.log\n          journalctl -f -u sudo.service\nmaxretry = 4\nbantime  = -1\"\"\",\n\"\"\"# ── SDDM / graphical login ────────────────────────────────────────────────\n# The real attack surface on a laptop: anyone who walks up to it, or reaches\n# it over the network, hits this.\n#\n# Uses the shipped `pam-generic` filter, NOT a dedicated `sddm` filter.\n# fail2ban-filter-sddm does not exist in the Arch repos; sddm authenticates\n# through PAM and emits the same failure lines pam-generic matches, so this\n# is equivalent coverage without an uninstallable dependency.\n[sddm]\nenabled  = true\nport     = sddm\nfilter   = pam-generic\nlogpath  = /var/log/auth.log\n          journalctl -f -u sddm.service -u sddm-greeter.service\nmaxretry = 5\nbantime  = -1\n\n# ── sudo ──────────────────────────────────────────────────────────────────\n# Privilege-escalation attempts. Same reasoning: pam-generic, not a\n# fail2ban-filter-sudo that does not exist in the repos.\n[sudo]\nenabled  = true\nport     = sudo\nfilter   = pam-generic\nlogpath  = /var/log/auth.log\n          journalctl -f -u sudo.service\nmaxretry = 4\nbantime  = -1\"\"\")\nopen(p,'w').write(s)\nprint(\"  [✓] rewritten to use shipped filters only\")\nPY" action.permission=* action.action=allow action.pattern=*
