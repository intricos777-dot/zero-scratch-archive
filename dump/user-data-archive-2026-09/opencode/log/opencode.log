timestamp=2026-09-26T19:31:03.940Z level=INFO run=01b4c3ae message=evaluated permission=bash pattern="python3 - <<'PY'\np='faillock.conf'\ns=open(p).read()\ns=s.replace(\n\"\"\"# 1800s = 30 minutes: long enough that a determined attacker gains nothing\n# from a single attempt, short enough that a fat-fingered admin is never\n# stranded. Default is 600s (10 min).\nunlock_time = 1800\"\"\",\n\"\"\"# 30 seconds — set 2026-09-26 at user request, down from 1800s.\n# Tradeoff: an account locked after `deny` failures frees up in 30s, so an\n# attacker gets 10 attempts every 30s (~1,200/hour) instead of 10 every\n# 30 min (20/hour). This makes faillock close to decorative against an\n# online guessing attack. It does NOT affect lockout risk — short unlock\n# means you get locked out less, not more. Password strength is now the\n# only thing standing between a compromised account and full access.\nunlock_time = 30\"\"\")\nopen(p,'w').write(s)\nprint(\"  [✓] project copy updated to 30s\")\nPY" action.permission=* action.action=allow action.pattern=*
