timestamp=2026-09-26T21:14:55.841Z level=INFO run=501861cf message=evaluated permission=bash pattern="python3 - <<'PY'\nimport re, pathlib\np = pathlib.Path(\"install-arpwatch-spoof.sh\")\ns = p.read_text()\n\ns = s.replace('''echo \"[3/5] preparing state\"''', '''echo \"[3/6] preparing state\"''')\ns = s.replace('echo \"[1/5] checking prerequisites\"', 'echo \"[1/6] checking prerequisites\"')\ns = s.replace('echo \"[2/5] installing arpwatch\"',  'echo \"[2/6] installing arpwatch\"')\n\n# state dir must be writable by the scanner (root) and hold the datafile\ns = s.replace('''run sudo install -d -m 0750 -o livings -g livings /var/lib/arpwatch''',\n'''run sudo install -d -m 0750 -o root -g root /var/lib/arpwatch\n# arpwatch(8): \"an empty arp.dat file must be created before the first run\".\nrun sudo install -m 0644 -o root -g root /dev/null /var/lib/arpwatch/arp.dat''')\n\n# replace the single-unit step with a three-unit step\nold = s[s.index('echo \"[4/5] installing unit\"'):s.index('echo \"[5/5] enabling\"')]\nnew = '''echo \"[4/6] installing units\"\nUNIT_TMP=\"$(mktemp)\"\nfor u in arpwatch-spoof.service arpwatch-spoof-scan.service arpwatch-spoof-scan.timer; do\n    sed -e \"s#/home/livings#$TARGET_HOME#g\" \"$HERE/$u\" > \"$UNIT_TMP\"\n    if ! grep -q \"^Environment=HOME=\" \"$UNIT_TMP\"; then\n        sed -i \"/^\\\\[Service\\\\]/a Environment=HOME=$TARGET_HOME\" \"$UNIT_TMP\"\n    fi\n    run sudo install -Dm644 \"$UNIT_TMP\" \"$UNIT_DST_DIR/$u\"\n    echo \"    installed $u\"\ndone\nrm -f \"$UNIT_TMP\"\n\n'''\ns = s.replace(old, new)\n\ns = s.replace('echo \"[5/5] enabling\"', '''echo \"[5/6] checking scanner prerequisites\"\n[ -x \"$SCAN\" ] || { echo \"    ERROR: scanner not executable: $SCAN\" >&2; exit 1; }\necho \"    scanner executable\"\nrun \"$SCAN\" --selftest || true\n\necho \"[6/6] enabling\"''')\n\ns = s.replace('''run sudo systemctl daemon-reload\nrun sudo systemctl enable --now arpwatch-spoof.service''',\n'''run sudo systemctl daemon-reload\nrun sudo systemctl enable --now arpwatch-spoof.service\nrun sudo systemctl enable --now arpwatch-spoof-scan.timer''')\n\ns = s.replace('HERE=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\\n', '')\ns = s.replace('UNIT_SRC=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)/arpwatch-spoof.service\"\\nUNIT_DST=/etc/systemd/system/arpwatch-spoof.service',\n              'HERE=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"')\np.write_text(s)\nprint(\"rewritten\")\nPY" action.permission=* action.action=allow action.pattern=*
