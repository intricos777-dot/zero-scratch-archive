timestamp=2026-09-26T18:42:19.608Z level=INFO run=01b4c3ae message=evaluated permission=bash pattern="python3 - <<'PY'\nimport json\nfrom collections import Counter\nd=json.load(open('repos_all.json'))\nprint(\"=== by language ===\")\nfor k,v in Counter((r['language'] or '(none)') for r in d).most_common():\n    print(f\"  {k:<22} {v}\")\nprint(\"\\n=== by size ===\")\nsizes=sorted(d,key=lambda r:-r['size'])\nprint(f\"  total {sum(r['size'] for r in d)/1024:.1f} MB   largest: {sizes[0]['size']/1024:.1f} MB ({sizes[0]['name']})\")\nprint(f\"  empty repos: {[r['name'] for r in d if r['size']==0]}\")\nprint(\"\\n=== staleness ===\")\nfrom datetime import datetime,timezone\nnow=datetime.now(timezone.utc)\nbuckets={'<30d':0,'30-90d':0,'90-365d':0,'>1yr':0}\nfor r in d:\n    age=(now-datetime.fromisoformat(r['updated_at'].replace('Z','+00:00'))).days\n    k='<30d' if age<30 else '30-90d' if age<90 else '90-365d' if age<365 else '>1yr'\n    buckets[k]+=1\nfor k in ['<30d','30-90d','90-365d','>1yr']: print(f\"  {k:<9} {buckets[k]}\")\nprint(\"\\n=== top 15 by recency ===\")\nfor r in sizes[:0] or sorted(d,key=lambda r:r['updated_at'],reverse=True)[:15]:\n    print(f\"  {r['updated_at'][:10]}  {'priv' if r['private'] else 'pub ':<4} {(r['language'] or '-'):<10} {r['name'][:44]}\")\nPY" action.permission=* action.action=allow action.pattern=*
