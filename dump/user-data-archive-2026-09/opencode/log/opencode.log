timestamp=2026-09-26T19:02:05.311Z level=INFO run=01b4c3ae message=evaluated permission=bash pattern="python3 - <<'PY'\nimport re,collections\nkeys=[]\nfor l in open('99-hardening.conf'):\n    l=l.strip()\n    if l and not l.startswith('#') and '=' in l:\n        keys.append(l.split('=')[0].strip())\ndupes=[k for k,c in collections.Counter(keys).items() if c>1]\nprint(f\"  keys parsed: {len(keys)}\")\nprint(f\"  duplicates : {dupes if dupes else 'none'}\")\nbad=[k for k in keys if not re.match(r'^(net|fs|kernel)\\.[a-z0-9_.]+$',k)]\nprint(f\"  malformed  : {bad if bad else 'none'}\")\nPY" action.permission=* action.action=allow action.pattern=*
