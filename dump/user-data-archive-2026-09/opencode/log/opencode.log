timestamp=2026-09-26T20:36:48.564Z level=INFO run=01b4c3ae message=evaluated permission=bash pattern="rsync -a --exclude='.git' --exclude='venv' --exclude='__pycache__' --exclude='*.bak' --exclude='*.pyc' \\\n      ~/Projects/zen-hardening/ config/zen-hardening/" action.permission=* action.action=allow action.pattern=*
timestamp=2026-09-26T20:36:48.564Z level=INFO run=01b4c3ae message=evaluated permission=bash pattern="git add -A" action.permission=* action.action=allow action.pattern=*
timestamp=2026-09-26T20:36:48.564Z level=INFO run=01b4c3ae message=evaluated permission=bash pattern="git -c user.name=opencode -c user.email=opencode@localhost commit -q -m \"Fix MAC randomization: NM flags enum, 1 means never\n\nThe previous fix set 802-11-wireless.mac-address-randomization=1,\nassuming a boolean. It is a flags enum, and the numeric aliases are\nnot boolean: 1 is NEVER, not yes. The setting was therefore silently\nturning randomization OFF, and nmcli helpfully reported 'never'.\n\nNetworkManager 1.58.1 accepts exactly: default | never | always\n('yes' and 'random' are both rejected). Switched to 'always'.\n\nWorth noting this class of failure is invisible by construction: the\nsetting is accepted, reports a plausible value, and does the opposite\nof what was asked. Confirmed on the live interface that randomization\nhad never taken effect -- wlo1 was still broadcasting the hardware MAC\nf4:a4:75:e8:00:b2.\n\nCo-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>\" 2>&1" action.permission=* action.action=allow action.pattern=*
