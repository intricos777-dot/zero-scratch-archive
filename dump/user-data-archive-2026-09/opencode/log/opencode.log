timestamp=2026-09-26T19:02:20.213Z level=INFO run=01b4c3ae message=evaluated permission=bash pattern="cat > firewalld-workstation.conf << 'EOF'\n# Workstation firewall — Garuda Linux / Arch\n# Install:  sudo cp firewalld-workstation.conf /etc/firewalld/zones/public.xml\n# Revert:   sudo rm /etc/firewalld/zones/public.xml && sudo firewall-cmd --reload\n#\n# Zone: public (Garuda's default active zone)\n# Ports opened: SSH only. Steam requires more and is NOT configured here —\n# add explicitly with:  sudo firewall-cmd --add-port=27017-27019/tcp --permanent\n#   (Steam In-Home Streaming)  and  --add-port=27015-27016/udp (matchmaking)\n\n<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<zone>\n  <short>Public</short>\n  <description>Workstation profile: deny incoming except SSH.</description>\n\n  <service name=\"ssh\"/>\n\n  <!-- No mdns/broadcast chatter on untrusted networks -->\n  <service name=\"mdns\" disable=\"yes\"/>\n  <service name=\"samba-client\" enable=\"no\"/>\n\n  <!-- ICMP: keep ping for diagnostics, drop everything else -->\n  <protocol value=\"icmp\"/>\n  <protocol value=\"ipv6-icmp\"/>\n\n  <masquerade/>\n</zone>\nEOF" action.permission=* action.action=allow action.pattern=*
