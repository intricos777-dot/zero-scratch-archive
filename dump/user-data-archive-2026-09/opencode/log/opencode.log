timestamp=2026-09-26T20:50:14.604Z level=INFO run=501861cf message=evaluated permission=bash pattern="buildlog warn \"THREE REAL GAPS found while auditing 'ban remote access for 1 day': (1) ignoreip includes 10.0.0.0/8 and this machine IS 10.197.250.246/8, so 16,777,216 addresses on the local network are permanently exempt from banning -- fail2ban cannot ban 'another system' on this network at all. (2) sshd jail is INERT: sshd is inactive, nothing listens on 22. (3) kdeconnectd is LAN-exposed on *:1716 (tcp+udp) with NO jail -- the only real remote attack surface, and it is unmonitored\" 2>&1" action.permission=* action.action=allow action.pattern=*
