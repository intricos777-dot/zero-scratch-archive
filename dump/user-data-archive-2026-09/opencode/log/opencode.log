timestamp=2026-09-26T20:03:18.204Z level=INFO run=501861cf message=evaluated permission=bash pattern="git commit -q -m \"seed-vcs-sources.sh: pre-seed makepkg VCS sources as shallow mirrors\n\nmakepkg's download_git() does 'git clone --mirror' for any git+ source not\nalready on disk. For chromium/chromium that is a 37 GiB full-history mirror\nand it dies mid-transfer; for the ~164 chromium-mirror_* DEPS repos it is\nmerely wasteful, since building a pinned tree never needs the history.\n\nA pre-seeded bare repo makes download_git() take its fetch branch instead,\nwhich is cheap and whose failure is only a warning.\"" action.permission=* action.action=allow action.pattern=*
