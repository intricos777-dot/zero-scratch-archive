timestamp=2026-09-26T21:13:04.818Z level=INFO run=501861cf message=evaluated permission=bash pattern="cat > arpwatch-spoof.service <<'EOF'\n[Unit]\nDescription=ARP spoof watcher (arpwatch datafile collector)\nDocumentation=file://%h/Projects/zen-hardening/arpwatch-spoof-scan.sh\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\n# arpwatch 3.9 flags ONLY. It has no -a (exec hook), no -u, no -c, and wants\n# -i INTERFACE rather than a positional argument. Getting this wrong is what\n# made the earlier version exit 1 in a restart loop.\n#\n#   -F  stay in the foreground; systemd wants the process, not a fork\n#   -i  interface (3.9 syntax)\n#   -f  datafile the scanner reads\n#   -s  no email reports; there is no MTA here and it would queue forever\n#   -q  no syslog report spam; the scanner does its own detection and notifies\n#   -N  no bogon reports  -- important on a /8, where most traffic looks odd\n#   -z  no 0.0.0.0 reports -- arpwatch(8) recommends this for busy DHCP networks\nExecStart=/usr/sbin/arpwatch -F -i wlo1 -f /var/lib/arpwatch/arp.dat -s -q -N -z\nRestart=on-failure\nRestartSec=30\n\n# Needs the raw socket only. Runs as root because pcap_bind needs it; the\n# datafile is what the unprivileged scanner reads.\nNoNewPrivileges=true\nPrivateTmp=true\nProtectKernelTunables=true\nProtectControlGroups=true\nRestrictSUIDSGID=true\nReadWritePaths=/var/lib/arpwatch\n\n[Install]\nWantedBy=multi-user.target\nEOF" action.permission=* action.action=allow action.pattern=*
timestamp=2026-09-26T21:13:04.819Z level=INFO run=501861cf message=evaluated permission=bash pattern="cat > arpwatch-spoof-scan.service <<'EOF'\n[Unit]\nDescription=Scan arpwatch datafile for ARP spoofing\nDocumentation=file://%h/Projects/zen-hardening/arpwatch-spoof-scan.sh\nAfter=arpwatch-spoof.service\n\n[Service]\nType=oneshot\nEnvironment=HOME=/home/livings\nExecStart=/home/livings/Projects/zen-hardening/arpwatch-spoof-scan.sh\nNoNewPrivileges=true\nPrivateTmp=true\nProtectKernelTunables=true\nProtectControlGroups=true\nRestrictSUIDSGID=true\nProtectSystem=full\nProtectHome=read-only\nReadWritePaths=/var/lib/arpwatch /var/log\nEOF" action.permission=* action.action=allow action.pattern=*
timestamp=2026-09-26T21:13:04.819Z level=INFO run=501861cf message=evaluated permission=bash pattern="cat > arpwatch-spoof-scan.timer <<'EOF'\n[Unit]\nDescription=Scan for ARP spoofing every 2 minutes\nRequires=arpwatch-spoof.service\nAfter=arpwatch-spoof.service\n\n[Timer]\nOnBootSec=2min\nOnUnitActiveSec=2min\nAccuracySec=15s\nUnit=arpwatch-spoof-scan.service\n\n[Install]\nWantedBy=timers.target\nEOF" action.permission=* action.action=allow action.pattern=*
