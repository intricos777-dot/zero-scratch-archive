2026-09-26 16:26:57,922 WARNING agent.message_sanitization: Unrepairable tool_call arguments for write_file — replaced with empty object (was: {"content": "#!/usr/bin/env python3\n\"\"\"Add non-Steam-game shortcuts to Steam's binary shortcuts.vdf.\n\nBoth CLIs are TUI programs, so the target is konsole rather than the bare\nexecutable: a terminal emulator started directly from Steam gets no PTY and\nno window, and the program either refuses to run or draws to nothing.\n\nSteam keeps shortcuts.vdf in memory and rewrites the whole file on exit, so\nthis MUST run while Steam is closed. It refuses to touch the file if the\nclient is up, and it makes a timestamped backup either way.\n\nUsage:\n    steam-shortcuts-add.py            # add/replace the entries\n    steam-shortcuts-add.py --remove   # remove just these entries\n\"\"\"\nimport os\nimport struct\nimport subprocess\nimport sys\nimport time\nfrom pathlib import Path\n\nUSERDATA = Path(os.environ.get(\"STEAM_USERDATA\",\n                                Path.home() / \".local/share/Steam/userdata\"))\nVFDF = \"shortcuts.vdf\"\n\n# Terminal-wrapped so the TUI gets a real PTY. %U would inject Steam's args,\n# which these do not want.\nSHORTCUTS = [\n    {\n        \"name\": \"Hermes Agent\",\n        \"exe\": \"/usr/bin/konsole\",\n        \"args\": \"-e /usr/bin/hermes\",\n        \"startdir\": str(Path.home()),\n        \"icon\": \"/usr/share/icons/hicolor/scalable/apps/hermes.png\",\n    },\n    {\n        \"name\": \"opencode\",\n        \"exe\": \"/usr/bin/konsole\",\n        \"args\": \"-e /usr/bin/opencode\",\n        \"startdir\": str(Path.home()),\n        \"icon\": \"/usr/share/icons/hicolor/scalable/apps/opencode.png\",\n    },\n]\n\n\ndef steam_running():\n    \"\"\"True if a steam client process exists. -C counts processes, not matches.\"\"\"\n    r = subprocess.run([\"pgrep\", \"-c\", \"-x\", \"steam\"],\n                       capture_output=True, text=True)\n    try:\n        return int(r.stdout.strip()) > 0\n    except ValueError:\n        return False\n\n\ndef appid_for(exe, name):\n    \"\"\"Steam's own scheme: crc32 over 'exe' + name, flagged high so it can\n    never collide with a real AppID.\"\"\"\n    import zlib\n    crc = zlib.crc32(f\"{exe}{name}\".encode()) & 0xFFFFFFFF\n    return crc | 0x80000000\n\n\n# --- binary VDF primitives -------------------------------------------------\n# shortcuts.vdf strings are NUL-terminated and NOT length-prefixed (unlike\n# config.vdf). uint32 fields carry a 0x02 type byte; strings carry 0x01.\n\ndef s(text):\n    return b\"\\x01\" + text.encode(\"utf-8\") + b\"\\x00\"\n\n\ndef u32(val):\n    return b\"\\x02\" + struct.pack(\"<I\", val)\n\n\ndef obj(name, body):\n    return b\"\\x00\" + name.encode() + b\"\\x00\" + body + b\"\\x00\"\n\n\ndef entry(rec, index):\n    tags = b\"\"\n    for tag in (\"Hermes\", \"opencode\"):\n        pass\n    taglist = obj(\"tags\", b\"\")\n    body = b\"\"\n    body += b\"appid\" + b\"\\x00\" + u32(appid_for(rec[\"exe\"], rec[\"name\"]))\n    body += b\"AppName\" + b\"\\x00\" + s(rec[\"name\"])\n    body += b\"Exe\" + b\"\\x00\" + s(rec[\"exe\"])\n    body += b\"StartDir\" + b\"\\x00\" + s(rec[\"startdir\"])\n    body += b\"icon\" + b\"\\x00\" + s(rec[\"icon\"])\n    body += b\"ShortcutPath\" + b\"\\x00\" + s(\"\")\n    body += b\"LaunchOptions\" + b\"\\x00\" + s(rec[\"args\"])\n    body += b\"IsHidden\" + b\"\\x00\" + u32(0)\n    body += b\"AllowDesktopConfig\" + b\"\\x00\" + u32(1)\n    body += b\"AllowOverlay\" + b\"\\x00\" + u32(1)\n    body += b\"OpenVR\" + b\"\\x00\" + u32(0)\n    body += b\"Devkit\" + b\"\\x00\" + u32(0)\n    body += b\"DevkitGameID\" + b\"\\x00\" + s(\"\")\n    body += b\"DevkitOverrideAppID\" + b\"\\x00\" + u32(0)\n    body += b\"LastPlayTime\" + b\"\\x00\" + u32(0)\n    body += taglist\n    return obj(str(index), body)\n\n\ndef read_entries(blob):\n    \"\"\"Parse the names+exes out of an existing file so we can merge, not\n    clobber. Returns [(index, name, exe)].\"\"\"\n    out = []\n    for chunk in blob.split(b\"\\x00\"):\n        pass\n    # Names appear as 0x01 <text> 0x00 right after the 'AppName' key.\n    i = 0\n    idx = None\n    while i < len(blob):\n        if blob[i:i + 1] == b\"\\x00\" and blob[i + 1:i + 1 + 7] == b\"AppName\":\n            j = blob.index(b\"\\x01\", i)\n            end = blob.index(b\"\\x00\", j + 1)\n            out.append((idx, blob[j + 1:end].decode(\"utf-8\", \"replace\")))\n            i = end\n            continue\n        if blob[i:i + 1] == b\"\\x00\":\n            seg = blob[i + 1:blob.find(b\"\\x00\", i + 1)]\n            if seg.isdigit():\n                idx = int(seg)\n        i += 1\n    return out\n\n\ndef main():\n    remove)
